        HAL_Delay(20); // anti-rebote
        if(HAL_GPIO_ReadPin(botonj1_GPIO_Port, botonj1_Pin) == GPIO_PIN_RESET) {
            contadorJ1 = (contadorJ1 + 1) % 10;
            actualizarLEDsJugador1(contadorJ1);
        }
    }
    if(GPIO_Pin == botonj2_Pin) {
        HAL_Delay(20); // anti-rebote
        if(HAL_GPIO_ReadPin(botonj2_GPIO_Port, botonj2_Pin) == GPIO_PIN_RESET) {
            contadorJ2 = (contadorJ2 + 1) % 10;
            actualizarLEDsJugador2(contadorJ2);
        }
    }
    if(GPIO_Pin == botoninicio_Pin) {
        contadorJ1 = 0;
        contadorJ2 = 0;
        actualizarLEDsJugador1(contadorJ1);
        actualizarLEDsJugador2(contadorJ2);
    }
}
