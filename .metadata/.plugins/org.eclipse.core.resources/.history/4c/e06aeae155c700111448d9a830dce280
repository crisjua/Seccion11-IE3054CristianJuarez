  }

  FRESULT f_mount(FATFS *fs, const TCHAR *path, BYTE opt);
  FRESULT f_open(FIL* fp, const TCHAR* path, BYTE mode);
  TCHAR* f_gets(TCHAR* buff, int len, FIL* fp);
  FRESULT f_close(FIL* fp);
  FRESULT f_read(FIL* fp, void* buff, UINT btr, UINT* br);
  FRESULT f_write(FIL* fp, const void* buff, UINT btr, UINT* br);

  fres = f_mount(&fs, "", 0);
  if (fres != FR_OK) {
   transmit_uart("Micro SD card is mounted succesfully!\n");
   } else if (fres != FR_OK){
   transmit_uart("Micro SD car munt error");
   }
      // 2. Crear archivo nuevo
      fres = f_open(&fil, "PRUEBA.TXT", FA_OPEN_APPEND | FA_WRITE | FA_READ);
      if (fres == FR_OK) {
          transmit_uart("File opened for reading and checking the free space\n");
      } else if (fres != FR_OK){
    	  transmit_uart("File was not opned for reading an checking the free space\n");
      }
       for (uint8_t i = 0; i <10; i++){
        	  f_puts("This text is written in the file.\n",&fil);
       }
          // 4. Cerrar archivo
          fres = f_close(&fil);
          if (fres == FR_OK) {
              transmit_uart("The file is closed.\n");
          } else if (fres != FR_OK){
              transmit_uart("The file was not closed.\n");
          }
      fres = f_open(&fil, "PRUEBA.TXT", FA_READ);
      if (fres == FR_OK){
    	  transmit_uart("File opened for reading\n");
      } else if (fres != FR_OK){
