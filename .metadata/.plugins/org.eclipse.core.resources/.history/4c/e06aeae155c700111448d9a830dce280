int puedeMover(int nuevoX, int nuevoY) {
    int tileX = nuevoX / TILE_SIZE;
    int tileY = nuevoY / TILE_SIZE;

    // Si el tile es sólido (1), no se mueve
    if (mapa[tileY][tileX] == 1) {
        return 0;
    }
    return 1;
}

int dentroPantalla(int nuevoX, int nuevoY) {
    if (nuevoX < 0) return 0; // límite izquierdo
    if (nuevoY < 0) return 0; // límite superior
    if (nuevoX + KIRBY_WIDTH >= SCREEN_WIDTH) return 0; // límite derecho
    if (nuevoY + KIRBY_HEIGHT >= SCREEN_HEIGHT) return 0; // límite inferior
    return 1; // dentro de la pantalla
}

