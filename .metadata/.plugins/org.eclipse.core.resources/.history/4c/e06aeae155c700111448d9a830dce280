      } else if (fres != FR_OK){
    	  transmit_uart("The file was not closed\n");
      }
      // 5. Desmontar SD
      fres = f_mount(NULL, "", 1);
      if (fres == FR_OK) {
          transmit_uart("SD unmounted.\n");
      } else {
          transmit_uart("SD unmount error.\n");
      }

  char msg[] = "STM32 listo\r\n";

  // --- MENÚ DE INICIO ---
  LCD_Init();
  LCD_Clear(0x0000);
  LCD_Bitmap_Scaled(0, 0, 160, 120, fondoInicio);
  LCD_Print("Presiona cualquier boton", 20, 100, 2, 0xFFFF, 0x0000);

  // Esperar botón
  while (HAL_UART_Receive(&huart1, (uint8_t*)&rx, 1, 100) != HAL_OK);

  // Reproducir música de inicio
  playMelody(kirbyMelody, kirbyDurations, kirbyLength);


  // --- ESCENARIO PRINCIPAL ---
  LCD_Clear(0x0000);
  LCD_Bitmap_Scaled(0, 0, 160, 120, fondoKirby);

  // dibuja bloques del escenario
  for (int x = 0; x < 319; x += 15) {

      LCD_Bitmap(x, 207, 15, 15, tile);
      LCD_Bitmap(x, 223, 15, 15, tile);
  }

  // dibuja a Kirby en la posición inicial
  LCD_Sprite(posX, posY, KIRBY_WIDTH, KIRBY_HEIGHT, kirby, 4, 0, 0, 0);
  // Dibujar enemigo al iniciar
  LCD_Sprite(enemigoX, enemigoY,
             ENEMIGO_WIDTH, ENEMIGO_HEIGHT,
             enemigo, 2, 0, 0, 0xF81F);
  // preparar UART para recibir datos del mando
  HAL_UART_Receive_IT(&huart1, (uint8_t*)&rx, 1);
  HAL_UART_Transmit(&huart1, (uint8_t*)msg, sizeof(msg)-1, 100);


  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
	LCD_Sprite(posX, posY, 21, 22, kirby, 4, 0, 0, 0);

	while (1) {
	    // Recepción de datos desde el ESP32
		if (hayComando)
		{
		    uint8_t comando;

		    __disable_irq();
		    comando = comandoPendiente;
		    hayComando = 0;
		    __enable_irq();

		    if (comando == 'L' && dentroPantalla(posX - 5, posY))
		    {
		        posX -= 5;
		        flip = 1;
		    }
		    else if (comando == 'R' && dentroPantalla(posX + 5, posY))
		    {
		        posX += 5;
		        flip = 0;
		    }
		    else if (comando == 'A' && enSuelo)
		    {
		        velY = -12;
		        enSuelo = 0;
		    }

		    if (comando == 'L' || comando == 'R' || comando == 'A')
		    {
		        playMelody(kirbyMelody, kirbyDurations, kirbyLength);
		    }
		}
	    // Guardar posición anterior
	    int oldX = posX;
	    int oldY = posY;

	    // --- GRAVEDAD + DETECCIÓN DE BLOQUES ---
	    velY += 1;
	    int nuevoY = posY + velY;

	    int tileLeft  = posX / TILE_SIZE;
	    int tileRight = (posX + KIRBY_WIDTH - 1) / TILE_SIZE;
	    int tileY     = (nuevoY + KIRBY_HEIGHT) / TILE_SIZE;

	    if (tileY >= 0 && tileY < 15) {
	        if ((mapa[tileY][tileLeft] == 1 || mapa[tileY][tileRight] == 1) && velY >= 0) {
	            posY = tileY * TILE_SIZE - KIRBY_HEIGHT;
	            velY = 0;
	            enSuelo = 1;
	        } else {
	            posY = nuevoY;
	            enSuelo = 0;
	        }
	    } else {
	        posY = nuevoY;
	        enSuelo = 0;
	    }

	    // --- REDIBUJAR KIRBY ---
	    // Borrar sprite anterior en la posición vieja
	    LCD_Bitmap(oldX, oldY, KIRBY_WIDTH, KIRBY_HEIGHT, fondoKirby);
	    dibujarVidas();
	    // Animación según estado
	    if (enSuelo) {
	        anim = 0; // quieto en el suelo
	    } else {
	        anim = (anim + 1) % 4; // animación en el aire
	    }

	    // Dibujar sprite en la nueva posición
	    LCD_Sprite(posX, posY, KIRBY_WIDTH, KIRBY_HEIGHT, kirby, 4, anim, 0, 0);
	    // --- MOVIMIENTO AUTOMÁTICO DEL ENEMIGO ---
	    int enemigoXAnterior = enemigoX;

	    // Mover enemigo
	    enemigoX += enemigoDir * enemigoVel;

	    // Cambiar dirección al llegar a los límites
	    if (enemigoX <= 20) {
	        enemigoX = 20;
	        enemigoDir = 1;
	    }
	    else if (enemigoX + ENEMIGO_WIDTH >= SCREEN_WIDTH - 10) {
	        enemigoX = SCREEN_WIDTH - ENEMIGO_WIDTH - 10;
	        enemigoDir = -1;
	    }

	    // Animación sencilla
	    animEnemigo = (animEnemigo + 1) % 2;

	    // Borrar posición anterior
	    LCD_Bitmap(enemigoXAnterior, enemigoY,
	               ENEMIGO_WIDTH, ENEMIGO_HEIGHT, fondoKirby);

	    // Dibujar enemigo en nueva posición
	    LCD_Sprite(enemigoX, enemigoY,
	               ENEMIGO_WIDTH, ENEMIGO_HEIGHT,
	               enemigo, 2, animEnemigo % 4,
	               (enemigoDir == -1) ? 1 : 0, 0xF81F);

	    // --- DETECCIÓN DE COLISIÓN ENTRE KIRBY Y ENEMIGO ---
	    if (posX < enemigoX + ENEMIGO_WIDTH &&
	        posX + KIRBY_WIDTH > enemigoX &&
	        posY < enemigoY + ENEMIGO_HEIGHT &&
	        posY + KIRBY_HEIGHT > enemigoY) {

	        if (!invulnerable && vidas > 0) {
	            vidas--;          // resta una vida
	            dibujarVidas();   // actualiza la barra de vidas

	            invulnerable = 1; // activa invulnerabilidad
	            tiempoInvulnerable = HAL_GetTick(); // guarda el tiempo actual
	        }
	    }

	    // --- CONTROL DE INVULNERABILIDAD ---
	    if (invulnerable && (HAL_GetTick() - tiempoInvulnerable > 1000)) {
	        invulnerable = 0; // vuelve a estado normal después de 1 segundo
	    }

	    // --- GAME OVER ---
	    if (vidas <= 0) {
	        // --- EFECTO DE PARPADEO ---
	        for (int i = 0; i < 3; i++) {
	            LCD_Clear(0x0000);   // negro
	            HAL_Delay(200);
	            LCD_Clear(0xFFFF);   // blanco
	            HAL_Delay(200);
	        }
	        LCD_Clear(0x0000);

	        // Mostrar menú de Game Over
	        LCD_Print("GAME OVER", 100, 80, 2, 0xFFFF, 0x0000);
	        LCD_Print("Reinicia manualmente para jugar", 20, 120, 2, 0xFFFF, 0x0000);
	    }

	    HAL_Delay(40);

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	}
  /* USER CODE END 3 */
}

