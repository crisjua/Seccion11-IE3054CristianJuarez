  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_SPI1_Init();
  MX_USART1_UART_Init();
  MX_FATFS_Init();
  MX_TIM1_Init();
  /* USER CODE BEGIN 2 */
  HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
  #define DBG(s)  HAL_UART_Transmit(&huart2, (uint8_t*)(s), strlen(s), 200)
  void transmit_uart(const char *s) {
