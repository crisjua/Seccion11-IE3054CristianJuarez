void playSonic(void) {
    uint32_t totalTime = 0;

    for (uint32_t i = 0; i < melodyLength && totalTime < 10000; i++) {
        uint32_t freq = melody[i];
        uint32_t duration = 200 / noteDurations[i]; // ms

        // Configura TIM1 para la frecuencia
        htim1.Init.Period = (84000000 / (freq * 84)) - 1;
        HAL_TIM_PWM_Init(&htim1);

        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, htim1.Init.Period / 2);

        HAL_Delay(duration);
        totalTime += duration;

        // Silencio entre notas
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
        HAL_Delay(50);
        totalTime += 50;
    }
}
void playDOOM(void) {
    uint32_t totalTime = 0;

    for (uint32_t i = 0; i < doomLength && totalTime < 10000; i++) {
        uint32_t freq = doomMelody[i];
        uint32_t duration = 1000 / doomDurations[i]; // ms

        // Configura TIM1 para la frecuencia
        htim1.Init.Period = (84000000 / (freq * 84)) - 1;
        HAL_TIM_PWM_Init(&htim1);

        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, htim1.Init.Period / 2);

        HAL_Delay(duration);
        totalTime += duration;

        // Silencio breve entre notas
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
        HAL_Delay(50);
        totalTime += 50;
    }
}

