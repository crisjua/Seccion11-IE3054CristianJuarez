/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_SPI1_Init();
  MX_USART1_UART_Init();
  MX_FATFS_Init();
  /* USER CODE BEGIN 2 */
  /* USER CODE BEGIN 2 */
  #define DBG(s)  HAL_UART_Transmit(&huart2, (uint8_t*)(s), strlen(s), 200)

  fres = f_mount(&fs, "/", 0);
  if (fres == FR_OK){
  transmit_uart("Micro SD card is mounted succesfully!\n");
  } else if (fres != FR_OK){
  transmit_uart("Micro SD cards mount error!\n");
  }
  char msg[] = "STM32 listo\r\n";

  // --- MENÚ DE INICIO ---
  LCD_Init();
  LCD_Clear(0x0000);
  LCD_Print("Presiona cualquier boton", 20, 100, 2, 0xFFFF, 0x0000);

  while (1) {
      if (HAL_UART_Receive(&huart1, (uint8_t*)&rx, 1, 100) == HAL_OK) {
          break;
      }
  }

  // --- ESCENARIO PRINCIPAL ---
  LCD_Clear(0x0000); // limpia todo el menú
  LCD_Bitmap(0, 0, 320, 240, fondoKirby); // dibuja el fondo de Kirby

  // dibuja bloques del escenario
  for (int x = 0; x < 319; x += 15) {
      LCD_Bitmap(x, 116, 15, 15, tile);
      LCD_Bitmap(x, 207, 15, 15, tile);
      LCD_Bitmap(x, 223, 15, 15, tile);
  }

  // dibuja a Kirby en la posición inicial
  LCD_Sprite(posX, posY, KIRBY_WIDTH, KIRBY_HEIGHT, kirby, 4, 0, 0, 0);

  // preparar UART para recibir datos del mando
  HAL_UART_Receive_IT(&huart1, (uint8_t*)&rx, 1);
  HAL_UART_Transmit(&huart1, (uint8_t*)msg, sizeof(msg)-1, 100);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
	LCD_Sprite(posX, posY, 21, 22, kirby, 4, 0, 0, 0);

	while (1) {
	    // Recepción de datos desde el ESP32
	    if (HAL_UART_Receive(&huart1, (uint8_t*)&rx, 1, 100) == HAL_OK) {
	        char buffer[30];
	        sprintf(buffer, "Recibido: %c\r\n", rx);
	        HAL_UART_Transmit(&huart1, (uint8_t*)buffer, strlen(buffer), 100);

	        // Movimiento horizontal
	        if (rx == 'L' && dentroPantalla(posX - 5, posY)) posX -= 5;
	        if (rx == 'R' && dentroPantalla(posX + 5, posY)) posX += 5;

	        // Salto: solo si está en el suelo
	        if (rx == 'A' && enSuelo) {
	            velY = -12;   // impulso hacia arriba
	            enSuelo = 0;
	        }
	    }
	    // Guardar posición anterior
	    int oldX = posX;
	    int oldY = posY;

	    // --- GRAVEDAD + DETECCIÓN DE BLOQUES ---
	    velY += 1;
	    int nuevoY = posY + velY;

	    int tileLeft  = posX / TILE_SIZE;
	    int tileRight = (posX + KIRBY_WIDTH - 1) / TILE_SIZE;
	    int tileY     = (nuevoY + KIRBY_HEIGHT) / TILE_SIZE;

	    if (tileY >= 0 && tileY < 15) {
	        if ((mapa[tileY][tileLeft] == 1 || mapa[tileY][tileRight] == 1) && velY >= 0) {
	            posY = tileY * TILE_SIZE - KIRBY_HEIGHT;
	            velY = 0;
	            enSuelo = 1;
	        } else {
	            posY = nuevoY;
	            enSuelo = 0;
	        }
	    } else {
	        posY = nuevoY;
	        enSuelo = 0;
	    }

	    // --- REDIBUJAR KIRBY ---
	    // Borrar sprite anterior en la posición vieja
	    LCD_Bitmap(oldX, oldY, KIRBY_WIDTH, KIRBY_HEIGHT, fondoKirby);

	    // Animación según estado
	    if (enSuelo) {
	        anim = 0; // quieto en el suelo
	    } else {
	        anim = (anim + 1) % 4; // animación en el aire
	    }

	    // Dibujar sprite en la nueva posición
	    LCD_Sprite(posX, posY, KIRBY_WIDTH, KIRBY_HEIGHT, kirby, 4, anim, 0, 0);

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	}
  /* USER CODE END 3 */
}

