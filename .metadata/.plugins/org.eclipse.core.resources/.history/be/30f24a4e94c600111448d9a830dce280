/* USER CODE BEGIN 4 */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
    if (huart->Instance == USART1) {
        char buffer[30];
        sprintf(buffer, "Recibido: %c\r\n", rx);
        HAL_UART_Transmit(&huart1, (uint8_t*)buffer, strlen(buffer), 1);

        // Guardar posición anterior
        int oldX = posX;
        int oldY = posY;

        // Movimiento con colisión y límites de pantalla
        if (rx == 'L' && dentroPantalla(posX - 5, posY)) {
            posX -= 5;
            flip = 1; // voltear sprite a la izquierda
        }
        if (rx == 'R' && dentroPantalla(posX + 5, posY)) {
            posX += 5;
            flip = 0; // sprite normal (derecha)
        }
        if (rx == 'A' && enSuelo) {
            velY = -12;   // impulso de salto hacia arriba
            enSuelo = 0;
        }

        // Borrar sprite anterior en la posición vieja con el fondo
        LCD_Bitmap(oldX, oldY, KIRBY_WIDTH, KIRBY_HEIGHT, fondoKirby);

        // Animación según estado
        if (enSuelo) {
            anim = 0; // quieto en el suelo
        } else {
            anim = (anim + 1) % 4; // animación en el aire
        }

        // Dibujar Kirby en la nueva posición con flip
        LCD_Sprite(posX, posY, KIRBY_WIDTH, KIRBY_HEIGHT, kirby, 4, anim, flip, 0);

        // Rearmar recepción para el siguiente byte
        HAL_UART_Receive_IT(&huart1, (uint8_t*)&rx, 1);
    }
}

const char* fatfs_error_text(FRESULT res) {
    switch (res) {
        case FR_OK: return "FR_OK (sin error)";
        case FR_DISK_ERR: return "FR_DISK_ERR (error de hardware)";
        case FR_INT_ERR: return "FR_INT_ERR (error interno)";
        case FR_NOT_READY: return "FR_NOT_READY (disco no listo)";
        case FR_NO_FILE: return "FR_NO_FILE (archivo no encontrado)";
        case FR_NO_PATH: return "FR_NO_PATH (ruta no encontrada)";
        case FR_INVALID_NAME: return "FR_INVALID_NAME (nombre inválido)";
        case FR_DENIED: return "FR_DENIED (acceso denegado)";
        case FR_EXIST: return "FR_EXIST (archivo ya existe)";
        case FR_INVALID_OBJECT: return "FR_INVALID_OBJECT (objeto inválido)";
        case FR_WRITE_PROTECTED: return "FR_WRITE_PROTECTED (SD protegida contra escritura)";
        case FR_INVALID_DRIVE: return "FR_INVALID_DRIVE (unidad inválida)";
        case FR_NOT_ENABLED: return "FR_NOT_ENABLED (FatFs no habilitado)";
        case FR_NO_FILESYSTEM: return "FR_NO_FILESYSTEM (no hay sistema de archivos válido)";
        case FR_MKFS_ABORTED: return "FR_MKFS_ABORTED (formato abortado)";
        case FR_TIMEOUT: return "FR_TIMEOUT (tiempo de espera)";
        case FR_LOCKED: return "FR_LOCKED (bloqueado)";
        case FR_NOT_ENOUGH_CORE: return "FR_NOT_ENOUGH_CORE (memoria insuficiente)";
        case FR_TOO_MANY_OPEN_FILES: return "FR_TOO_MANY_OPEN_FILES (demasiados archivos abiertos)";
        default: return "Error desconocido";
    }
}

