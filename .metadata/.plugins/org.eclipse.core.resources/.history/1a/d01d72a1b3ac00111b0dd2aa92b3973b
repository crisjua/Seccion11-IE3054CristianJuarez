/* USER CODE BEGIN 4 */
void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef* hadc) {
    if (hadc->Instance == ADC1) {
        char msg[50];

        // Valores crudos
        sprintf(msg, "X:%u Y:%u\r\n", adc_val[0], adc_val[1]);
        HAL_UART_Transmit(&huart2, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);

        // Dirección en texto
        if (adc_val[0] > 2048) {
            HAL_UART_Transmit(&huart2, (uint8_t*)"Derecha\r\n", 9, HAL_MAX_DELAY);
        } else {
            HAL_UART_Transmit(&huart2, (uint8_t*)"Izquierda\r\n", 11, HAL_MAX_DELAY);
        }

        if (adc_val[1] > 2048) {
            HAL_UART_Transmit(&huart2, (uint8_t*)"Arriba\r\n", 8, HAL_MAX_DELAY);
        } else {
            HAL_UART_Transmit(&huart2, (uint8_t*)"Abajo\r\n", 7, HAL_MAX_DELAY);
        }
    }
}
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
    if (huart->Instance == USART2) {
        if (rxData != '\n') {
            rxBuffer[idx++] = rxData;
        } else {
            rxBuffer[idx] = '\0'; // fin de cadena
            HAL_UART_Transmit(&huart2, (uint8_t*)rxBuffer, strlen(rxBuffer), HAL_MAX_DELAY);
            HAL_UART_Transmit(&huart2, (uint8_t*)"\r\n", 2, HAL_MAX_DELAY);
            idx = 0;
        }
        HAL_UART_Receive_IT(&huart2, &rxData, 1); // reinicia recepción
    }
}
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
    if (htim->Instance == TIM2) {
        HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_val, 2);
    }
}

